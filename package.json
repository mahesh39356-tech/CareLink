{
  "name": "carelink-telemedicine-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:frontend": "vite",
    "dev:https": "vite --host --https",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "node scripts/dev-all.js",
    "dev:all:https": "node scripts/dev-all.js --https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "build:android": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.1",
    "lucide-react": "^0.469.0",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@types/node": "^22.10.1",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^6.0.3"
  }
}
