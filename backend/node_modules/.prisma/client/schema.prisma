generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         String   @default("PATIENT") // PATIENT, DOCTOR, HEALTH_WORKER, ADMIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient   PatientProfile?
  doctor    DoctorProfile?
  auditLogs AuditLog[]

  @@index([role])
}

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String?  @unique
  nationalId        String?  @unique
  fullName          String
  age               Int
  gender            String // Female, Male, Other
  bloodGroup        String? // A+, B+, O+, AB+, etc.
  allergies         String? // Comma-separated or text
  chronicConditions String?
  emergencyContact  String?
  village           String?
  clinic            String?  @default("Kijani Rural Clinic")
  syncHistory       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vitals         VitalRecord[]
  symptoms       SymptomRecord[]
  medicalRecords MedicalRecord[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  clinicalImages ClinicalImage[]
  voiceNotes     VoiceNote[]

  @@index([fullName])
  @@index([clinic])
}

model DoctorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  licenseNumber String   @unique
  fullName      String
  specialty     String   @default("General Tele-Specialist")
  hospital      String?  @default("CareLink Regional Hub")
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  prescriptions Prescription[]

  @@index([specialty])
}

model MedicalRecord {
  id            String   @id @default(uuid())
  patientId     String
  recordType    String   @default("INTAKE")
  clinicalNotes String
  diagnosis     String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model VitalRecord {
  id              String   @id @default(uuid())
  patientId       String
  consultationId  String?
  systolic        Int      @default(120)
  diastolic       Int      @default(80)
  temperature     Float    @default(36.8)
  heartRate       Int      @default(72)
  spO2            Int?     @default(98)
  respiratoryRate Int?     @default(16)
  weightKg        Float?
  triageLevel     String   @default("NORMAL") // NORMAL, ELEVATED, CRITICAL
  clientRecordId  String? // Client offline UUID
  recordedAt      DateTime @default(now())

  patient        PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation?   @relation(fields: [consultationId], references: [id])
  clinicalImages ClinicalImage[]
  voiceNotes     VoiceNote[]

  @@index([patientId])
  @@index([triageLevel])
}

model SymptomRecord {
  id             String   @id @default(uuid())
  patientId      String
  consultationId String?
  symptomName    String
  durationDays   Int      @default(1)
  severity       String   @default("MODERATE") // MILD, MODERATE, SEVERE
  description    String?
  recordedAt     DateTime @default(now())

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])

  @@index([patientId])
}

model ClinicalImage {
  id             String   @id @default(uuid())
  patientId      String
  consultationId String?
  vitalRecordId  String?
  fileRecordId   String   @unique
  bodySite       String   @default("DERMATOLOGY") // DERMATOLOGY, WOUND, OPHTHALMIC, GENERAL
  label          String   @default("IMAGE 01")
  metadataJson   String?
  capturedAt     DateTime @default(now())

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  vitalRecord  VitalRecord?   @relation(fields: [vitalRecordId], references: [id])
  fileRecord   FileRecord     @relation(fields: [fileRecordId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([consultationId])
}

model VoiceNote {
  id              String   @id @default(uuid())
  patientId       String
  consultationId  String?
  vitalRecordId   String?
  fileRecordId    String   @unique
  language        String   @default("Swahili")
  durationSeconds Int      @default(18)
  codec           String   @default("Opus")
  transcription   String?
  recordedAt      DateTime @default(now())

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  vitalRecord  VitalRecord?   @relation(fields: [vitalRecordId], references: [id])
  fileRecord   FileRecord     @relation(fields: [fileRecordId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([consultationId])
}

model Consultation {
  id             String    @id @default(uuid())
  caseNumber     String? // e.g. CL-2024-0418
  patientId      String
  doctorId       String?
  status         String    @default("PENDING") // PENDING, IN_REVIEW, COMPLETED, CANCELLED
  priority       String    @default("ROUTINE") // ROUTINE, URGENT
  reason         String?
  clinicalAdvice String?
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?

  patient        PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         DoctorProfile?  @relation(fields: [doctorId], references: [id])
  vitals         VitalRecord[]
  symptoms       SymptomRecord[]
  clinicalImages ClinicalImage[]
  voiceNotes     VoiceNote[]
  prescriptions  Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([caseNumber])
}

model Prescription {
  id               String    @id @default(uuid())
  rxNumber         String?   @unique
  consultationId   String
  patientId        String
  doctorId         String
  status           String    @default("DRAFT") // DRAFT, ISSUED, AMENDED
  diagnosis        String?
  medicationsJson  String // Serialized JSON of medicines
  clinicalRemarks  String? // Additional medical advice
  followUpDate     String? // Follow up date string
  doctorName       String?
  doctorRegNumber  String?
  digitalSignature String?
  signedAt         DateTime?
  issuedAt         DateTime?
  pdfPath          String?
  pdfSizeBytes     Int?
  amendedFromId    String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  consultation Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient      PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationId])
  @@index([status])
  @@index([rxNumber])
}

model SyncRecord {
  id             String   @id @default(uuid())
  clientId       String // Mobile client ID
  idempotencyKey String   @unique // Hash of submission
  batchId        String   @default(uuid())
  status         String   @default("DELIVERED") // PENDING, PROCESSING, DELIVERED, FAILED
  payloadBytes   Int      @default(0)
  sha256Hash     String
  recordsCount   Int      @default(1)
  clientPayload  String? // Stored GZIP payload ref
  synchronizedAt DateTime @default(now())

  @@index([clientId])
  @@index([idempotencyKey])
}

model FileRecord {
  id                   String   @id @default(uuid())
  category             String // JSON, IMAGE, AUDIO
  originalFilename     String
  originalPath         String
  compressedPath       String?
  decompressedPath     String?
  originalSizeBytes    Int
  compressedSizeBytes  Int?
  mimeType             String
  compressionAlgorithm String // GZIP, SHARP_WEBP, OPUS
  originalSha256       String
  decompressedSha256   String?
  isVerified           Boolean  @default(false)
  createdAt            DateTime @default(now())

  clinicalImage ClinicalImage?
  voiceNote     VoiceNote?

  @@index([category])
  @@index([originalSha256])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}
